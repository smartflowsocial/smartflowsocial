DATABASE_URL=
# Required for pnpm test:db:setup. This command does not fall back to DATABASE_URL.
# Use a database name that contains test, tests, or testing as its own word.
# Do not point it at the application database. Destructive reset is separate:
# CONFIRM_DESTRUCTIVE_TEST_DB_RESET=reset-test-database pnpm test:db:reset
TEST_DATABASE_URL=
SESSION_SECRET=
# Nostr publisher: https://github.com/smartflowsocial/smartflowsocial-publisher
NOSTR_PUBLISHER_URL=
# Must match the publisher API_TOKEN. Required in production unless you intentionally
# run a public publisher and set NOSTR_PUBLISHER_ALLOW_UNAUTHENTICATED=true.
# Generate: openssl rand -base64 32
NOSTR_PUBLISHER_API_TOKEN=

# Shared secret for /cron/* routes. Required in production.
# A missing value does not disable the check: the routes return 401.
# Send as X-Cron-Secret or Authorization: Bearer.
# Generate: openssl rand -base64 32
CRON_SECRET=
# Hours between worker purges of retained financial rows. Default 24. Set 0 to
# disable the in-process sweep. POST /cron/purge-retained-records still works.
# GET remains accepted so an existing scheduler does not break.
# FINANCIAL_RECORD_PURGE_INTERVAL_HOURS=24
# Seconds between worker retries of owned object deletions queued during
# account deletion. Default 60. Set 0 to disable the in-process sweep.
# The keys stay in OwnedObjectDeletion until storage deletion succeeds.
# OWNED_OBJECT_DELETION_INTERVAL_SECONDS=60

# Set to true, 1, or yes only when this install pays referral commissions from OWNER_NWC.
# Any other value, including false or unset, keeps cron, admin, and manual payout routes off.
# OWNER_NWC does not enable payouts. A deployment that previously paid because the wallet
# was set and this flag was unset must set true before upgrading, or referral payouts stop.
# When the flag is on, production boot also requires REFERRAL_MANUAL_PAYOUT_SECRET.
# A copied example.env uses false so a new self-host does not pay anyone.
REFERRAL_PAYOUTS_ENABLED=false
# SELF_HOSTED=true unlocks scheduler, bulk, broadcast, and giveaway software on an
# install you operate. Leave it unset on SmartFlowSocial managed hosting. It does not
# grant hosted Blossom storage or hosted Blastr. A browser request cannot set it.
# On a self-hosted install the campaign finalization commission is 0% for every plan.
# That does not disable winner payouts from a creator wallet the operator connects.
# NWC_PAY_TIMEOUT_MS and NWC_RECONCILE_TIMEOUT_MS bound pay_invoice and the later
# lookup. Defaults are 45000 and 15000. Values outside 50..120000 are ignored.
# NWC_PAY_TIMEOUT_MS=45000
# NWC_RECONCILE_TIMEOUT_MS=15000
# Optional operator caps. Blank means no cap. A non-numeric value is 0.
# SELF_HOSTED=true
# SELF_HOSTED_MAX_FUTURE_SCHEDULED=
# SELF_HOSTED_MAX_QUEUES=
# SELF_HOSTED_MAX_DRAFTS=
# SELF_HOSTED_MAX_TEMPLATES=
# SELF_HOSTED_MAX_ACCOUNTS=
# SELF_HOSTED_MAX_BROADCAST_RECIPIENTS=
# SELF_HOSTED_MAX_CONCURRENT_BROADCASTS=
# SELF_HOSTED_MAX_DAILY_BROADCAST_RECIPIENTS=
# SELF_HOSTED_MAX_GIVEAWAY_WINNERS=
# Secret for POST /api/referral/manual-payout. The route returns 401 when this is unset.
# It returns 404 when REFERRAL_PAYOUTS_ENABLED=false, including when the secret is present.
# Send as X-Referral-Payout-Secret.
# Generate: openssl rand -base64 32
REFERRAL_MANUAL_PAYOUT_SECRET=
# Local signature-checking publisher (`pnpm publisher:local`). Not the Cloudflare worker.
# It does not connect to relays. Use it to prove scheduling on a laptop.
# LOCAL_PUBLISHER_TOKEN=local-dev-publisher-token
# LOCAL_PUBLISHER_PORT=8787
# NOSTR_PUBLISHER_URL=http://127.0.0.1:8787/publish
# NOSTR_PUBLISHER_API_TOKEN=local-dev-publisher-token
# Optional caps, in sats. Defaults are 1000000 per invoice and 5000000 per UTC day.
# REFERRAL_PAYOUT_MAX_SATS=1000000
# REFERRAL_PAYOUT_DAILY_CAP_SATS=5000000
# Set to true only for a local LNURL endpoint on a private address.
# REFERRAL_PAYOUT_ALLOW_PRIVATE_LNURL=false
# Primal caching: https://github.com/PrimalHQ/primal-caching-service
# Two formats supported:
# - HTTP proxy (e.g. Cloudflare Worker): https://your-worker.workers.dev
# - WebSocket: wss://cache1.example.com/v1 or comma-separated list
# If not set, uses default WebSocket endpoints (cache1/2.primal.net)
PRIMAL_CACHING_URL=
# Engagement: Primal get_notifications (omit on self-hosted cache without this API)
# MENTIONS_USE_PRIMAL_GET_NOTIFICATIONS=false
# MENTIONS_RELAY_FALLBACK_ENABLED=true
# ENGAGEMENT_MENTIONS_DEBUG=false

# Feature flags (optional)
# Enable server-issued challenge/verify login (POST /auth/nostr/challenge + POST /auth/nostr/verify)
NOSTR_AUTH_V2_ENABLED=true
# NIP-17 gift-wrapped DMs when recipient has kind:10050 inbox relays (NIP-04 always sent too)
NOSTR_DM_NIP17_ENABLED=true
# NIP-88 polls (kind 1068/1018): composer, voting, tallies (default off)
# NIP88_POLLS_ENABLED=true
# Enforce invariant: every signed event pubkey must match the active session pubkey
ENFORCE_NOSTR_SESSION_PUBKEY=true

STORAGE_ACCESS_KEY=
STORAGE_SECRET=
STORAGE_REGION=
STORAGE_BUCKET=
REDIS_URL=
OWNER_NWC=
NODE_ENV=development
NOSTR_NSEC=
# npub (or hex) of the team inbox for in-app bug/feature feedback (sidebar). Users sign kind 4 (NIP-04); server only publishes.
# FEEDBACK_INBOX_NPUB=npub1...
# Sentry error tracking (optional)
# Get your DSN from https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
SENTRY_DSN=
# Security configuration (CSRF protection)
# Canonical app URL - used for CSRF origin validation
APP_URL=http://localhost:3000
# Comma-separated list of allowed origins for CSRF protection
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=
# Blossom (vibe-cdn) internal API: set same value as SFS_INTERNAL_SECRET on Blossom server
# Used by GET /internal/subscription-status for upload gating
BLOSSOM_INTERNAL_SECRET=
# Leave unset unless this server should upload to a Blossom API. There is no
# default. https://blossom-api.smartflow.social is SmartFlowSocial's hosted
# server. A self-hosted install does not contact it unless you set that URL.
# BLOSSOM_SFS_API_URL=
# Optional explicit token signing secret for Blossom v2 upload tokens
# If unset, BLOSSOM_INTERNAL_SECRET is used as fallback.
BLOSSOM_UPLOAD_TOKEN_SECRET=

# SFS Blastr: admin API for entitlement and policy sync (optional; no-op when unset)
# When set, paid subscription changes sync to Blastr and users can manage relay policy in Settings.
# BLASTR_ADMIN_URL=https://blastr.smartflow.social
# BLASTR_ADMIN_API_TOKEN=

# Metrics endpoint security
# Token required to access /metrics endpoint (recommended for production)
METRICS_TOKEN=
# Comma-separated list of allowed IPs for metrics endpoint (optional, alternative to token)
# Example: 127.0.0.1,10.0.0.0/8
METRICS_ALLOWED_IPS=
# Web Push Notifications (VAPID keys)
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Or use an online tool: https://web-push-codelab.glitch.me/
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID subject (optional, defaults to APP_URL or mailto:admin@smartflow.social)
# Should be a mailto: URL or your app URL
VAPID_SUBJECT=

# Public stats for the marketing site (GET /api/public/stats). On unless set to false.
# PUBLIC_STATS_ENABLED=false
# Extra browser origins allowed to read the stats route, comma-separated.
# LANDING_STATS_ORIGINS=https://www.smartflow.social

# ---------------------------------------------------------------------------
# Optional settings
# Everything below is optional and commented out. The value shown is the
# default, or an example where there is no default. Full descriptions:
# docs/reference/configuration.md
# ---------------------------------------------------------------------------

# Server
# HTTP listen port and host.
# PORT=3000
# HOST=0.0.0.0
# Prometheus /metrics port for the web process.
# METRICS_PORT=3010
# Prometheus /metrics port for the worker process.
# WORKER_METRICS_PORT=3011
# true disables rate limits. For tests and local debugging only.
# DISABLE_RATE_LIMIT=true
# true enables source maps outside production. Production always enables them.
# ENABLE_SOURCE_MAPS=true
# Where relay health is kept: memory or redis.
# RELAY_HEALTH_STORE=memory

# Admin area
# Comma-separated npubs allowed into /dashboard/admin. Empty means nobody.
# ADMIN_NPUBS=npub1...

# Storage
# Public CDN or domain that serves the same bucket. No trailing slash.
# STORAGE_CDN_URL=https://cdn.example.com

# Worker timers, in minutes. 0 turns a timer off.
# SUBSCRIPTION_RENEWAL_INTERVAL_MINUTES=60
# RUNWAY_LOW_CRON_INTERVAL_MINUTES=60
# POST_ANALYTICS_INTERVAL_MINUTES=60
# Notes per analytics sweep, and concurrent NostrMash calls inside one sweep.
# POST_ANALYTICS_BATCH_SIZE=40
# POST_ANALYTICS_CONCURRENCY=4

# NostrMash (optional read source for paid post analytics)
# NOSTRMASH_BASE_URL=https://api.nostrmash.com
# Bearer token, only when that deployment requires one.
# NOSTRMASH_API_TOKEN=

# Primal HTTP proxy: per-attempt timeout and extra retries after the first attempt.
# PRIMAL_HTTP_TIMEOUT_MS=8000
# PRIMAL_HTTP_MAX_RETRIES=0

# Lightning wallet relays. These override the relays embedded in OWNER_NWC.
# OWNER_NWC_RELAYS is a comma-separated list and is used before OWNER_NWC_RELAY.
# OWNER_NWC_RELAYS=wss://relay.example.com,wss://relay2.example.com
# OWNER_NWC_RELAY=wss://relay.example.com

# BTCPay Server (Greenfield API)
# BTCPAY_URL=https://btcpay.example.com
# BTCPAY_API_KEY=
# BTCPAY_STORE_ID=
# Verifies signatures on POST /api/btcpay/webhook.
# BTCPAY_WEBHOOK_SECRET=

# Referrals
# Base URL used in referral links.
# REFERRAL_LANDING_URL=https://smartflow.social

# Sentry sampling, a number from 0 to 1. Only used when SENTRY_DSN is set.
# Default is 0.1 in production and 1.0 otherwise.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Feature flags. true turns the feature on.
# MEDIA_PIPELINE_V2_ENABLED=true
# ENABLE_NOSTR_DELETE_EVENTS=true
# CONTESTS_V1_ENABLED=true
# SUBSCRIPTION_CHECKOUT_V2_ENABLED=true
# SIGNING_MULTI_SLOT=true

# Set by platforms and test runners. Do not set these by hand:
# FLY_REGION, PRIMARY_REGION, COOLIFY_URL, E2E_TEST, CYPRESS
