--- a/.gitignore
+++ b/.gitignore
@@ -1,6 +1,8 @@
 node_modules
 build/
 .env*
+.dev.vars
+.dev.vars.*
 *.log
 .DS_Store
 *.tsbuildinfo
diff --git a/README.md b/README.md
index f088ee0..8ca3140 100644
--- a/README.md
+++ b/README.md
@@ -48,7 +48,7 @@ It is not an open proxy to arbitrary private networks.
