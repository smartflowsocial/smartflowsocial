{
  "name": "smartflow-social",
  "version": "1.0.0-rc.1",
  "description": "A scheduler for Nostr. Sign with your own signer. The same code runs hosted or self-hosted.",
  "author": "SmartFlowSocial Team",
  "license": "Unlicense",
  "private": true,
  "type": "module",
  "imports": {
    "#nonce-context": {
      "types": "./scripts/nonce-context.d.ts",
      "default": "./scripts/nonce-context.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smartflowsocial/smartflowsocial.git"
  },
  "homepage": "https://smartflow.social",
  "bugs": {
    "url": "https://github.com/smartflowsocial/smartflowsocial/issues"
  },
  "keywords": [
    "nostr",
    "social-media",
    "react-router",
    "typescript",
    "lightning",
    "bitcoin",
    "scheduling",
    "content-management",
    "decentralized",
    "web3"
  ],
  "packageManager": "pnpm@12.21.0",
  "sideEffects": [
    "**/*.css",
    "**/*.server.ts",
    "**/*.server.tsx",
    "app/lib/error-handler.server.ts",
    "app/lib/zod-jitless.client.ts",
    "@js-temporal/polyfill"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "prepare": "husky",
    "build": "react-router build && node scripts/bundle-node.mjs server.ts && node scripts/bundle-node.mjs worker.ts && tsx scripts/verify-css-build.ts",
    "dev": "npm-run-all2 --parallel dev:server dev:serve dev:worker",
    "dev:server": "cross-env NODE_ENV=development E2E_TEST=${E2E_TEST:-} node scripts/bundle-node.mjs server.ts --watch",
    "dev:serve": "node scripts/wait-and-watch-server.cjs",
    "dev:worker": "node scripts/dev-worker.mjs",
    "docker": "docker compose up -d",
    "worker:local": "tsx -r dotenv/config worker.ts",
    "smoke:publish": "tsx scripts/relay-publish-integration.ts",
    "test:relay-publish": "tsx scripts/relay-publish-integration.ts",
    "test:self-host-acceptance": "tsx scripts/self-host-acceptance.ts",
    "check:compose": "node scripts/check-dev-compose.mjs docker-compose.yml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "printf '🔍 Running ESLint...\\n' && cross-env NODE_OPTIONS=--max-old-space-size=4096 NODE_COMPILE_CACHE=./.cache/node-compile-cache eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck:app": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "typecheck:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc -p tests/e2e/tsconfig.json --noEmit",
    "lint:ci": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint . || exit 1",
    "start": "node scripts/start-prod.mjs",
    "start:server": "cross-env NODE_ENV=production node ./build/server.js",
    "start:worker": "cross-env NODE_ENV=production node ./build/worker.js",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "pnpm test:coverage && node scripts/coverage-trend.cjs record",
    "test:coverage:trend": "node scripts/coverage-trend.cjs report",
    "test:coverage:gaps": "node scripts/coverage-gaps.cjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:performance": "vitest run tests/performance",
    "test:performance:budget": "node scripts/check-performance-budgets.mjs --source=vitest",
    "test:performance:budget:k6": "node scripts/check-performance-budgets.mjs --source=k6 --dir=tests/performance/results",
    "test:performance:budget:bundle": "node scripts/check-performance-budgets.mjs --source=bundle",
    "test:performance:all": "pnpm test:performance && echo '\n✅ Unit performance tests passed!\n\n📝 To run k6 load tests:\n   k6 run tests/performance/api-endpoints.js\n   k6 run tests/performance/bulk-operations.js\n   k6 run tests/performance/loader-performance.js'",
    "test:security": "vitest run tests/security",
    "test:db": "vitest run tests/integration -- --grep 'database'",
    "test:db:setup": "tsx scripts/test-db-setup.ts",
    "test:db:reset": "tsx scripts/test-db-reset.ts",
    "test:db:seed": "tsx tests/database/seed-test-db.ts",
    "test:all": "pnpm test && echo '\n✅ Vitest tests passed!\n\n📝 To run Cypress E2E tests:\n   1. Start dev server: pnpm dev\n   2. In another terminal: pnpm test:e2e\n\n   Or use: pnpm test:e2e:dev (starts server + opens Cypress UI)'",
    "test:e2e": "E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress run",
    "test:e2e:open": "E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress open",
    "test:e2e:smoke": "E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress run --spec \"tests/e2e/smoke/**/*.cy.ts\"",
    "test:e2e:core": "E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress run --spec \"tests/e2e/core/**/*.cy.ts\"",
    "test:e2e:extended": "E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress run --spec \"tests/e2e/extended/**/*.cy.ts\"",
    "test:e2e:dev": "start-server-and-test \"cross-env E2E_TEST=true PORT=3000 pnpm dev\" http://localhost:3000 \"E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress open\"",
    "test:e2e:run": "start-server-and-test \"cross-env E2E_TEST=true PORT=3000 pnpm dev\" http://localhost:3000 \"E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress run\"",
    "test:e2e:smoke:run": "start-server-and-test \"cross-env E2E_TEST=true PORT=3000 pnpm dev\" http://localhost:3000 \"E2E_TEST=true ALLOW_HYDRATION_EXCEPTIONS=false pnpm exec cypress run --spec \\\"tests/e2e/smoke/**/*.cy.ts\\\"\"",
    "test:e2e:production-csp": "pnpm exec cypress run --config specPattern=tests/e2e/release/production-csp.cy.ts --spec tests/e2e/release/production-csp.cy.ts",
    "typecheck": "react-router typegen && cross-env NODE_COMPILE_CACHE=./.cache/node-compile-cache ./scripts/typecheck.sh",
    "precheck": "pnpm lint && pnpm exec tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint:ci && pnpm typecheck",
    "clean": "rm -rf build .react-router node_modules/.cache coverage .tsbuildinfo",
    "lint:fix": "node scripts/fix-eslint-errors.cjs",
    "generate-icons": "tsx scripts/generate-pwa-icons.ts",
    "db:reseed-and-backfill-free": "tsx scripts/reseed-and-backfill-free.ts",
    "db:reseed-and-backfill-free:with-seed": "tsx scripts/reseed-and-backfill-free.ts --seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@gandlaf21/bolt11-decode": "^3.1.1",
    "@getalby/sdk": "^9.0.0",
    "@hookform/resolvers": "^7.0.7",
    "@js-temporal/polyfill": "^0.5.1",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@nostrify/nostrify": "^0.55.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/express": "8.5.1",
    "@react-router/node": "8.5.1",
    "@remix-run/form-data-parser": "1.1.1",
    "@sentry/react-router": "^11.14.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-devtools": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "bullmq": "^6.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.3.0",
    "isbot": "^5.2.3",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "morgan": "^1.10.1",
    "nostr-fetch": "^0.17.0",
    "nostr-relaypool": "^0.6.30",
    "nostr-tools": "^2.26.1",
    "pg": "^8.16.3",
    "prisma": "7.10.1",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.5.0",
    "react": "19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.0.18",
    "react-router": "8.5.1",
    "recharts": "^3.11.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "source-map-support": "^0.5.21",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.3",
    "turndown": "^7.2.5",
    "uuid": "^14.0.3",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.2.0",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@types/compression": "^1.8.1",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "chokidar": "^6.0.0",
    "cookie": "^2.0.2",
    "cypress": "^16.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jest-dom": "^5.10.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "fast-check": "^4.5.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-nesting": "^14.0.3",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "cross-env NODE_OPTIONS=--max-old-space-size=4096 NODE_COMPILE_CACHE=./.cache/node-compile-cache eslint --cache --cache-location ./node_modules/.cache/eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
